{
  "name": "blackbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "accept:baseline": "tsx src/cli/baseline-acceptance.ts",
    "lint": "oxlint",
    "smoke:runtime": "tsx src/cli/runtime-smoke.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@truefoundry/trueforge": "0.1.4",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "dotenv": "17.4.2",
    "hono": "4.13.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "22.20.1",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
